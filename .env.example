# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# GitHub Personal Access Token (required)
# Create at: https://github.com/settings/tokens
# Scopes needed: public_repo (read-only is enough)
GITHUB_TOKEN=your_github_pat_here

# OpenAI API Key (optional — falls back to template-based insights)
# Create at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model to use for insight generation
OPENAI_MODEL=gpt-4o-mini

# SQLite database path (relative to project root)
DB_PATH=data/openpulse.db
